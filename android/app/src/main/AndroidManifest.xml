<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 前面アプリの検知（設定画面からユーザーが明示的に許可する特別権限） -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- バックグラウンドからクイズ画面を起動するために必要（Android 10+ の制限の免除） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="SNSQuizLocker"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@style/Theme.SNSQuizLocker">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- クイズ関所。監視サービスから起動される全画面 WebView。
             taskAffinity を分けて独立タスクにする: finish で直前のアプリ（=ゲート発動元の
             SNSアプリ）に戻すため。設定画面のタスクに積むと解除後に設定画面へ戻ってしまう。 -->
        <activity
            android:name=".QuizActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.luis8492.snsquizlocker.quiz"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.SNSQuizLocker.Quiz" />

        <!-- 前面アプリの監視（フォアグラウンドサービス） -->
        <service
            android:name=".WatchdogService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="digital-wellbeing: detect launch of user-selected SNS apps and show a quiz gate before use" />
        </service>
    </application>
</manifest>
