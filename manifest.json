{
  "manifest_version": 3,
  "name": "YouTube 書き取り関所",
  "version": "1.0.0",
  "description": "YouTubeの動画を開くと、書き取り・聴音・詰将棋などの課題を課します。全問正解するまで動画は見られません。見すぎ防止用。",
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "出題プラグインの選択",
    "default_popup": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*",
        "*://*.reddit.com/*"
      ],
      "js": [
        "core/registry.js",
        "core/ui.js",
        "config.js",
        "core/sites.js",
        "quizzes/koten/passages.js",
        "quizzes/koten/koten.js",
        "quizzes/hyakunin/poems.js",
        "quizzes/hyakunin/hyakunin.js",
        "quizzes/juon/juon.js",
        "quizzes/tsume/shogi.js",
        "quizzes/tsume/problems.js",
        "quizzes/tsume/tsume.js",
        "core/host.js"
      ],
      "css": [
        "core/overlay.css",
        "quizzes/koten/koten.css",
        "quizzes/hyakunin/hyakunin.css",
        "quizzes/juon/juon.css",
        "quizzes/tsume/tsume.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "continue.html",
        "core/registry.js",
        "core/ui.js",
        "config.js",
        "core/sites.js",
        "quizzes/koten/passages.js",
        "quizzes/koten/koten.js",
        "quizzes/hyakunin/poems.js",
        "quizzes/hyakunin/hyakunin.js",
        "quizzes/juon/juon.js",
        "quizzes/tsume/shogi.js",
        "quizzes/tsume/problems.js",
        "quizzes/tsume/tsume.js",
        "core/overlay.css",
        "quizzes/koten/koten.css",
        "quizzes/hyakunin/hyakunin.css",
        "quizzes/juon/juon.css",
        "quizzes/tsume/tsume.css"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*",
        "*://*.reddit.com/*"
      ]
    }
  ]
}
