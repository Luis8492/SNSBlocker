{
  "manifest_version": 3,
  "name": "YouTube 書き取り関所",
  "version": "1.0.0",
  "description": "YouTubeの動画を開くと、古典文学の書き取りを課します。3問正解するまで動画は見られません。見すぎ防止用。",
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["texts.js", "quiz.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["continue.html", "quiz.js", "texts.js", "overlay.css"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
