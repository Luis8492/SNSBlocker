{
  "manifest_version": 3,
  "name": "YouTube 書き取り関所",
  "version": "1.0.0",
  "description": "YouTubeの動画を開くと、古典文学の書き取りを課します。作品の全問を正解するまで動画は見られません。見すぎ防止用。",
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": [
        "core/registry.js",
        "core/ui.js",
        "config.js",
        "quizzes/dictation/passages.js",
        "quizzes/dictation/dictation.js",
        "core/host.js"
      ],
      "css": ["core/overlay.css", "quizzes/dictation/dictation.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "continue.html",
        "core/registry.js",
        "core/ui.js",
        "config.js",
        "quizzes/dictation/passages.js",
        "quizzes/dictation/dictation.js",
        "core/overlay.css",
        "quizzes/dictation/dictation.css"
      ],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
